CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPEN_LIBRARY_CONTACT=
# Optional: both are required to turn on the Gemini provider. Leave empty to serve the catalog fallback only.
# Use synthetic data only while on the free tier (ADR-008). Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=
# Per-IP AI cap per hour. Default 30; 0 turns the per-IP cap off. Invalid values fall back to 30.
# WARNING: verify on a deployed function (log req.ip once in a staging call) before relying on the
# per-IP cap; set AI_IP_LIMIT_PER_HOUR=0 to turn it off.
AI_IP_LIMIT_PER_HOUR=
# Trusted proxy hops for req.ip. Default 1; integer >= 0. Invalid values fall back to 1.
TRUST_PROXY_HOPS=
