{
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      ".github",
      ".env",
      ".env.*",
      "*.md",
      "*-debug.log",
      "firebase-debug*.log",
      "firestore-debug*.log",
      "coverage",
      "docs",
      "emulator-data",
      ".emulator-data",
      "firebase-export-*",
      "openapi",
      "scripts",
      "seed",
      "test",
      "eslint.config.mjs",
      "lefthook.yml",
      "tsconfig.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
